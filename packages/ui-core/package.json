{
  "name": "@my-project/ui-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:js\" \"npm:dev:css\"",
    "dev:js": "tsup --watch",
    "dev:css": "npm run build:css -- --watch",
    "build": "npm run build:types && npm run build:js && npm run build:css",
    "build:types": "tsc --project tsconfig.build.json",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/global.css -o ./dist/styles.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^18.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "react": "^18.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
