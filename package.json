{
  "name": "my-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/postinstall.mts",
    "dev": "node --experimental-strip-types scripts/dev.mts",
    "build": "node --experimental-strip-types scripts/build.mts",
    "typecheck": "node --experimental-strip-types scripts/typecheck.mts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-all": "npm run typecheck && npm run lint && npm run format"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.57.1"
  }
}
